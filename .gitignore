*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.onnx
*.log
deliverables/

# --- Secrets / local config (must never exist here; blocked by guardrail) ---
.env
.env.*
*.key
*.pem
*.p12
secrets/

# --- OS noise ---
.DS_Store
Thumbs.db
desktop.ini
